<form>
    <field>
        <id>clientlookupclient.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this client name mapping.</help>
        <grid_view>
            <width>6em</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>clientlookupclient.name</id>
        <label>Client name</label>
        <type>text</type>
        <help>Custom name for the client, used by client groups and query logs.</help>
        <grid_view/>
    </field>
    <field>
        <id>clientlookupclient.ips</id>
        <label>IP addresses</label>
        <type>select_multiple</type>
        <style>tokenize</style>
        <allownew>true</allownew>
        <hint>192.168.1.10</hint>
        <help>One or more client IP addresses that map to this name.</help>
        <grid_view/>
    </field>
    <field>
        <id>clientlookupclient.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for your reference.</help>
        <grid_view/>
    </field>
</form>
