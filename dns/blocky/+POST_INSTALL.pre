#!/bin/sh

# before the install renders the templates: config.yml and its staged copy can hold a Redis password
# or query log database credentials, and the template writer copies the mode of the directory it
# writes into (minus exec), making a missing one 0755
install -d -m 0750 -o root -g wheel /usr/local/etc/blocky
# list files Blocky may read from disk
install -d -m 0750 -o root -g wheel /usr/local/etc/blocky/lists
# secrets Blocky reads from file: values
install -d -m 0700 -o root -g wheel /usr/local/etc/blocky/secrets
