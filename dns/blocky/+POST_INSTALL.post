# config.yml can hold a Redis password or query log database credentials, and the
# template writer copies the mode of the directory it writes into (minus exec).
install -d -m 0750 -o root -g wheel /usr/local/etc/blocky
if [ -f /usr/local/etc/blocky/config.yml ]; then
	chmod 0640 /usr/local/etc/blocky/config.yml
fi
