# The FreeBSD version a package is built for (its FreeBSD_version annotation). pkg refuses one
# built for a newer FreeBSD than the firewall runs, or with a stamp it cannot read, and one such
# package fails the whole catalogue (libpkg is_valid_os_version), so a repository holds none.
# Sourced by build-repo.sh; STAMPS_PKG names the pkg to run.

# the package's FreeBSD_version: nothing when it has none, - when it is empty; false when pkg
# cannot read the package
pkg_stamp()
{
	local out
	out=$(${STAMPS_PKG:-pkg} query -F "$1" '%At %Av') || return 1
	printf '%s\n' "${out}" | awk '$1 == "FreeBSD_version" { print ($2 == "" ? "-" : $2); exit }'
}

# true when the package is built for a FreeBSD above base, or its stamp is one pkg refuses
# (unreadable, no number, below 1)
stamp_above()
{
	local stamp
	stamp=$(pkg_stamp "$1") || return 0
	case "${stamp}" in
	"") return 1 ;;
	*[!0-9]*) return 0 ;;
	esac
	[ "${stamp}" -lt 1 ] || [ "${stamp}" -gt "$2" ]
}

# fail, naming each package in the directories built for a FreeBSD above base
stamps_check()
{
	local base dir pkg stamp status
	base=$1
	shift
	status=0
	for dir in "$@"; do
		for pkg in "${dir}"/*.pkg; do
			[ -f "${pkg}" ] || continue
			if stamp_above "${pkg}" "${base}"; then
				stamp=$(pkg_stamp "${pkg}") || stamp="(unreadable)"
				echo "${pkg}: built for ${stamp}, above this base ${base}" >&2
				status=1
			fi
		done
	done
	return ${status}
}
